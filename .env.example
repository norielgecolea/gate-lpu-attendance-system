# Copy to .env and fill in real values:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Tomcat ---
TOMCAT_PORT=8080
TOMCAT_USERNAME=admin
TOMCAT_PASSWORD=change-me

# --- App (optional overrides; compose has defaults) ---
# Base64-encoded 256-bit secret for JWT signing
APP_JWT_SECRET=bHB1LWdhdGUtYXR0ZW5kYW5jZS1qd3Qtc2VjcmV0LWtleS0zMmJ5dGVzIQ==

# --- Cloudflare Tunnel ---
# From Zero Trust → Networks → Tunnels → your tunnel → token
CLOUDFLARE_TUNNEL_TOKEN=

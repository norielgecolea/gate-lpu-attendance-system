# Copy to .env and fill in real values:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Tomcat ---
# Host port maps only to tomcat-1 for direct debugging. Clustered traffic goes through nginx :80.
TOMCAT_PORT=8080
TOMCAT_USERNAME=admin
TOMCAT_PASSWORD=change-me

# --- App (optional overrides; compose has defaults) ---
# Base64-encoded 256-bit secret for JWT signing
APP_JWT_SECRET=bHB1LWdhdGUtYXR0ZW5kYW5jZS1qd3Qtc2VjcmV0LWtleS0zMmJ5dGVzIQ==

# Redis is required in Docker (APP_REDIS_ENABLED=true on tomcat-1/tomcat-2).
# Leave unset for local IDE runs without Redis.

# --- Cloudflare Tunnel ---
# From Zero Trust → Networks → Tunnels → your tunnel → token
CLOUDFLARE_TUNNEL_TOKEN=

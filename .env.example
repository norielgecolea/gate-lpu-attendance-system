# Copy to .env and fill in real values:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Tomcat ---
TOMCAT_PORT=8080
TOMCAT_USERNAME=admin
TOMCAT_PASSWORD=change-me

# --- App ---
# Leave unset to generate a private signing key in data/secrets on first start.
# Do not commit a real value. Generate one with: openssl rand -base64 32
# APP_JWT_SECRET=

# --- Cloudflare Tunnel ---
# From Zero Trust → Networks → Tunnels → your tunnel → token
CLOUDFLARE_TUNNEL_TOKEN=

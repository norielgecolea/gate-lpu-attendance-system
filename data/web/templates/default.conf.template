map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream tomcat_backend {
    least_conn;
    server tomcat-1:8080 max_fails=3 fail_timeout=10s;
    server tomcat-2:8080 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

server {
    listen       ${NGINX_PORT};
    listen  [::]:${NGINX_PORT};
    server_name  ${SERVER_NAME};

    client_max_body_size 2g;

    # Backend API + WebSocket (Tomcat WAR context), load-balanced across replicas.
    location /attendance-system/ {
        proxy_pass http://tomcat_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_next_upstream error timeout http_502 http_503;
    }

    # Angular frontend (production SSR on :4200, or ng serve when FRONTEND_MODE=development)
    location / {
        proxy_pass http://${UPSTREAM_HOST}:${UPSTREAM_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400;
        # Login/about HTML must not be cached or Cloudflare keeps an old version number.
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }
}
